.reservation-modal{
    position:fixed;
    inset:0;

    width:100%;
    height:100%;

    background:rgba(0,0,0,.6);

    display:flex;
    justify-content:center;
    align-items:center;

    opacity:0;
    visibility:hidden;

    transition:
        opacity .3s ease,
        visibility .3s ease;

    z-index:10003;
}

.reservation-modal.show{
    opacity:1;
    visibility:visible;
}

.reservation-content{
    position:relative;

    width:95%;
    max-width:600px;
    max-height:90vh;

    overflow-y:auto;

    background:#fff;
    border-radius:20px;
    padding:30px;

    transform:scale(.9);

    transition:transform .3s ease;
}

.reservation-modal.show .reservation-content{
    transform:scale(1);
}

.close-modal{
    position:absolute;

    top:15px;
    right:15px;

    width:40px;
    height:40px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:24px;

    background:#ff6b00;
    color:#fff;

    border:none;
    border-radius:50%;

    cursor:pointer;

    z-index:10;
}

.reservation-btn{
    display:flex;
    align-items:center;
    gap:8px;

    padding:10px 18px;

    background:#fff;
    color:#ff6b00;

    border:2px solid #ff6b00;
    border-radius:999px;

    font-weight:600;
    text-decoration:none;

    cursor:pointer;

    transition:.3s;
}

.reservation-btn:hover{
    background:#ff6b00;
    color:#fff;
}