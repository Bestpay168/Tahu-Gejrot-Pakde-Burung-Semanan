.reservation-modal{

position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,.6);

display:flex;
justify-content:center;
align-items:center;

opacity:0;
visibility:hidden;

transition:.3s;

z-index:9999;

}

.reservation-modal.show{

opacity:1;
visibility:visible;

}

.reservation-content{

width:95%;
max-width:600px;

background:#fff;

border-radius:20px;

padding:30px;

position:relative;

transform:scale(.9);

transition:.3s;

}

.reservation-modal.show .reservation-content{

transform:scale(1);

}

.close-modal{

position:absolute;
top:15px;
right:15px;

font-size:30px;

background:none;
border:none;

cursor:pointer;

}

reservation-btn{

display:flex;
align-items:center;
gap:8px;

padding:10px 18px;

background:#ffffff;

color:#ff6b00;

border:2px solid #ff6b00;

border-radius:999px;

font-weight:600;

text-decoration:none;

transition:.3s;

}

.reservation-btn:hover{

background:#ff6b00;

color:#fff;

}
